# ---------------------------------------------------------------------------
# GrauFence environment. Copy to `.env` and edit:  cp .env.example .env
# Nothing here is a secret today — the game has no accounts, no database and no
# third-party API keys. The file exists so deploys have one place to configure
# hosts and ports, and so that stays true if auth is ever added.
# ---------------------------------------------------------------------------

# ---- server (packages/server) ---------------------------------------------

# Port the WebSocket + health HTTP server binds to.
# Render/Railway/Fly inject their own PORT; leave this alone in production.
PORT=8787

# Host interface to bind. 0.0.0.0 is required inside most container hosts.
HOST=0.0.0.0

# Comma-separated list of origins allowed to open a WebSocket.
# Use "*" for local development only. In production list your real frontend
# origin(s), e.g. https://graugames.github.io,https://graufence.example.com
ALLOWED_ORIGINS=*

# Max messages a single connection may send per second before it is throttled
# (and, if it keeps flooding, disconnected). 60 is generous: a playing client
# sends ~25/s.
MAX_MESSAGES_PER_SECOND=60

# Seconds a disconnected player's slot is held open for reconnection before the
# room forfeits the round and cleans up.
RECONNECT_GRACE_SECONDS=30

# ---- client (packages/client) ---------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code.

# WebSocket URL of the server. Leave unset in local dev: the client defaults to
# ws://<current-host>:8787. In production this MUST be a wss:// URL.
# VITE_SERVER_URL=wss://graufence-server.onrender.com

# Override the MediaPipe pose model. Defaults to Google's CDN-hosted
# pose_landmarker_lite.task (see README > MediaPipe model). Point this at your
# own copy if you would rather self-host the ~5 MB model file.
# VITE_POSE_MODEL_URL=/models/pose_landmarker_lite.task

# Set to 1 to open the debug panel automatically (same as adding ?debug=1).
# VITE_DEBUG=0
